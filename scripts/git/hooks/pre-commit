#!/bin/sh
# ClipRefiner pre-commit: cargo fmt --check

if [ "$CLIP_REFINER_SKIP_HOOK" = "1" ]; then
    exit 0
fi

root="$(git rev-parse --show-toplevel)" || exit 1

# 呼び出すスクリプトは #requires -Version 7.0 のため、Windows PowerShell 5.1 へはフォールバックしない
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh (PowerShell 7 以上) が見つかりません。インストールしてください" >&2
    exit 1
fi

exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/windows/check-pre-commit.ps1"
