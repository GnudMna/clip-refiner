{
  "name": "clip-refiner",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "ClipRefiner UI TypeScript の品質チェック・バンドル用 (本番バイナリには npm 依存を同梱しない)",
  "scripts": {
    "build:ui": "node scripts/common/build-ui.ts",
    "build:ui:check": "node scripts/common/build-ui.ts --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b",
    "knip": "knip",
    "audit:deps": "npm audit --audit-level=high",
    "test:ui": "node --test \"crates/clip-refiner/tests/ui/*.ts\"",
    "test:ui:coverage": "node scripts/common/check-ui-coverage.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "jiti": "^2.7.0",
    "knip": "^6.48.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
