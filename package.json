{
  "name": "clip-refiner",
  "private": true,
  "type": "module",
  "description": "ClipRefiner UI JavaScript の品質チェック・バンドル用 (本番バイナリには npm 依存を同梱しない)",
  "scripts": {
    "build:ui": "node scripts/common/build-ui.mjs",
    "build:ui:check": "node scripts/common/build-ui.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"crates/clip-refiner/**/*.js\" \"scripts/**/*.mjs\" eslint.config.js",
    "format:check": "prettier --check \"crates/clip-refiner/**/*.js\" \"scripts/**/*.mjs\" eslint.config.js",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
