{
  "name": "clip-refiner",
  "private": true,
  "type": "module",
  "description": "ClipRefiner UI JavaScript の品質チェック・バンドル用 (本番バイナリには npm 依存を同梱しない)",
  "scripts": {
    "build:ui": "node scripts/common/build-ui.mjs",
    "build:ui:check": "node scripts/common/build-ui.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write \"crates/clip-refiner/**/*.js\" \"crates/clip-refiner/**/*.d.ts\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" eslint.config.js",
    "format:check": "prettier --check \"crates/clip-refiner/**/*.js\" \"crates/clip-refiner/**/*.d.ts\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" eslint.config.js",
    "typecheck": "tsc -p e2e && tsc -p crates/clip-refiner/src/ui",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
